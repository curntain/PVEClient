# PVE 远程管理客户端 · 可选设置
#
# 复制成 client.env 后按需修改，然后重启客户端即可生效。
# 存放位置（放哪都行，两个位置都会读取）：
#   Windows : %LOCALAPPDATA%\PVEClient\client.env   （也可以在 exe 同目录放一份）
#   macOS   : ~/Library/Application Support/PVEClient/client.env
#             （Mac 版外壳也支持 ~/.pveclient.env，两者等价）
#
# 真实的环境变量优先级高于本文件；命令行参数优先级最高。

# ---- 远程访问：应用层登录（不设置 = 关闭，仅本机 127.0.0.1 可用）----
# 格式 用户名:口令 ；只写口令时用户名固定为 pve
# 口令由部署者自己生成，不存在默认口令；不要把实际口令提交到 GitHub
# PVE_CLIENT_AUTH=admin:换成你的强口令

# ---- 监听地址与端口 ----
# 反代 / 隧道和客户端在同一台机器时，保持 127.0.0.1 最安全
# PVE_CLIENT_HOST=127.0.0.1
# 固定端口，方便反代配置；不设置则每次自动挑一个空闲端口
# PVE_CLIENT_PORT=8765

# ---- 内嵌管理系统端口基准（端口 = 基准 + VMID，默认 9000）----
# PVE_CLIENT_EMBED_BASE_PORT=9000

# ---- 走 HTTPS 的反代后面打开这两项，登录状态才能跨子域名共享 ----
# PVE_CLIENT_COOKIE_DOMAIN=.example.com
# PVE_CLIENT_COOKIE_SECURE=1

# ---- 客户端窗口直接用公网地址打开（不设置则用 127.0.0.1）----
# PVE_CLIENT_PUBLIC_URL=https://pve.example.com/

# ---- macOS 自动选择内外网 ----
# 内网地址能在 0.8 秒内访问时直连，否则自动回退到上面的公网地址
# PVE_CLIENT_LOCAL_URL=http://192.168.1.10:8765/
# 服务端开启可信内网免登录；来源地址会经过可信代理链校验
# PVE_CLIENT_LAN_BYPASS=1
# PVE_CLIENT_LAN_NETWORKS=192.168.1.0/24
# 只有通过这些内网 Host 访问才免登录，公网域名始终要求认证
# PVE_CLIENT_LAN_HOSTS=192.168.1.10,127.0.0.1,localhost
# 仅填写实际反代/隧道的来源网段；默认只信任本机回环代理
# PVE_CLIENT_TRUSTED_PROXIES=127.0.0.0/8,::1/128
# 外网登录会话时长，范围 1～168 小时
# PVE_CLIENT_SESSION_HOURS=24

# ---- 后台运行：只跑服务不弹窗口（配合任务计划程序 / launchd）----
# PVE_CLIENT_NO_WINDOW=1

# ---- 排错 ----
# PVE_CLIENT_DEBUG=1
